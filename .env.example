# ==============================================================================
# KisanDirect AI - Production Environment Variables
# Copy this file to .env and configure secrets prior to starting the production server.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration
# Local SQLite file path or volume mount path
DATABASE_PATH=backend/multi_portal.db
DATABASE_URL=sqlite:///app/backend/data/multi_portal.db

# Authentication & Security
# Secret key used for signing and verifying JSON Web Tokens (JWT)
# Generate a strong 256-bit secret (e.g., `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production

# Platform Owner / DOCA Super-Admin Credentials
# Pre-seeded master regulator credentials required to authenticate to /owner/control-room
ADMIN_EMAIL=owner@kisandirect.com
ADMIN_PASSWORD=replace_with_a_strong_owner_master_password

# Public API URL (Optional - leave blank to use relative paths '/api/...')
API_URL=
